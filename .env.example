# Environment configuration for the local API.
# Copy this file to .env only when using a process manager that loads dotenv values.
PORT=8787
CPM_DATA_FILE=./server/data/projects.json
# Set a long random value before exposing the API outside localhost.
CPM_AUTH_TOKEN=replace-with-a-long-random-secret
# Restrict browser access in production, for example:
# CPM_ALLOWED_ORIGIN=https://your-dashboard.example
